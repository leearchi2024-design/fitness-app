[
  {"id":"o01","notionId":"407d474379d88106ab90c8f3fa273e43","動作名稱":"手腕伸肌伸展","訓練部位":["手腕","手臂"],"主要肌群":"前臂伸肌群","動作要點":"手臂往前伸直、掌心朝下並讓手掌往下垂，另一手把手背輕輕往身體方向壓，感覺前臂外側拉開（常用滑鼠者必做）","常見錯誤":"手肘彎曲、手指握拳過緊、壓太用力","建議次數組數":"每邊 15–20 秒 × 2 回","難度":"新手","器材":"徒手","示範影片":"media/office/o01.svg"},
  {"id":"o02","notionId":"407d474379d8810993f0cdc3063ddaab","動作名稱":"手腕屈肌伸展","訓練部位":["手腕","手臂"],"主要肌群":"前臂屈肌群","動作要點":"手臂往前伸直、掌心朝前（手指朝上），另一手把手指輕輕往身體方向扳，感覺前臂內側拉開","常見錯誤":"手肘彎曲、扳太用力、聳肩","建議次數組數":"每邊 15–20 秒 × 2 回","難度":"新手","器材":"徒手","示範影片":"media/office/o02.svg"},
  {"id":"o03","notionId":"407d474379d881199eecf6668b39335f","動作名稱":"跨胸手臂伸展","訓練部位":["肩","上背"],"主要肌群":"三角肌後束、菱形肌","動作要點":"右手伸直橫過胸前，左手扣住右手肘往身體帶，感覺右肩後側拉開","常見錯誤":"被拉的肩膀聳起、身體跟著轉、扣在手腕而非手肘","建議次數組數":"每邊 20–30 秒 × 2 回","難度":"新手","器材":"徒手","示範影片":"media/office/o03.svg"},
  {"id":"o04","notionId":"407d474379d88122a7ebd034ac57402c","動作名稱":"收下巴","訓練部位":["頸"],"主要肌群":"深層頸屈肌、枕下肌群","動作要點":"坐直、肩膀放鬆，下巴「水平往後推」做出雙下巴，感覺後頸被拉長，停留後放鬆","常見錯誤":"變成低頭點頭、聳肩、仰頭","建議次數組數":"每下停 5 秒 × 10 下 × 2 組","難度":"新手","器材":"徒手","示範影片":"media/office/o04.svg"},
  {"id":"o05","notionId":"407d474379d88125b8f3d65a7f567ffd","動作名稱":"肩胛後收（夾背）","訓練部位":["上背","肩"],"主要肌群":"菱形肌、中下斜方肌","動作要點":"坐直，手肘彎 90° 貼在身側，把兩側肩胛骨往後、往下夾緊，像要夾住一支筆，停留後放鬆","常見錯誤":"聳肩、挺腰代償、頭往前伸","建議次數組數":"每下停 5 秒 × 10–15 下","難度":"新手","器材":"徒手","示範影片":"media/office/o05.svg"},
  {"id":"o06","notionId":"407d474379d88127b090cf69ae269d4f","動作名稱":"坐姿側彎伸展","訓練部位":["上背","核心"],"主要肌群":"背闊肌、腰方肌、肋間肌","動作要點":"坐直雙腳踩穩，雙手舉高，左手抓住右手腕，身體往左側彎，感覺右側腰到腋下拉長","常見錯誤":"身體往前倒、臀部離開椅面、聳肩","建議次數組數":"每邊 15–20 秒 × 2 回","難度":"新手","器材":"徒手","示範影片":"media/office/o06.svg"},
  {"id":"o07","notionId":"407d474379d8813b9737cab8f7bcb517","動作名稱":"站姿髖屈肌伸展","訓練部位":["腿","下背"],"主要肌群":"髂腰肌、股直肌","動作要點":"站在椅旁扶著椅背，右腳往前、左腳在後成弓箭步，骨盆微微後捲並往前推，感覺左大腿前側到鼠蹊拉開","常見錯誤":"身體往前傾、腰往前凹、腳尖外八","建議次數組數":"每邊 20–30 秒 × 2 回","難度":"新手","器材":"椅子","示範影片":"media/office/o07.svg"},
  {"id":"o08","notionId":"407d474379d88148a339fd8c738e1ba8","動作名稱":"椅背胸椎伸展","訓練部位":["上背","胸"],"主要肌群":"胸椎伸肌、胸大肌","動作要點":"坐在有椅背的椅子，雙手抱頭（手肘打開），上背靠在椅背頂緣，以此為支點慢慢往後仰，再回正","常見錯誤":"用腰往前凹代償、手拉脖子、仰得太快","建議次數組數":"每下停 3 秒 × 6–8 下","難度":"中階","器材":"椅子","示範影片":"media/office/o08.svg"},
  {"id":"o09","notionId":"407d474379d88149bc2dd29a4de1c58d","動作名稱":"坐姿貓牛式（縮腹拱背）","訓練部位":["上背","下背","核心"],"主要肌群":"豎脊肌、腹直肌","動作要點":"坐在椅子前緣、雙手放膝上；吐氣時縮腹、背往後拱、低頭；吸氣時挺胸、骨盆前傾、眼睛看前上方，兩者交替","常見錯誤":"只動脖子不動脊椎、動作太快、憋氣","建議次數組數":"8–10 次來回","難度":"新手","器材":"椅子","示範影片":"media/office/o09.svg"},
  {"id":"o10","notionId":"407d474379d8814fb04ec193f1bb3cdf","動作名稱":"提肩胛肌伸展","訓練部位":["頸","肩"],"主要肌群":"提肩胛肌","動作要點":"右手抓椅面，頭轉向左 45°，再低頭看左側褲子口袋，左手扶後腦輕輕往下帶，感覺右後頸到肩胛內上角拉開","常見錯誤":"頭沒先轉角度、駝背、用力壓頭","建議次數組數":"每邊 20–30 秒 × 2 回","難度":"中階","器材":"椅子","示範影片":"media/office/o10.svg"},
  {"id":"o11","notionId":"407d474379d88170b609fe34766ffbdf","動作名稱":"坐姿前彎（拜天拜地）","訓練部位":["下背","核心"],"主要肌群":"豎脊肌、腹肌","動作要點":"坐在椅子前緣、雙腳打開，吐氣時從頭一節一節往前彎，手垂向地面；吸氣時再一節一節捲回坐直","常見錯誤":"起身太快頭暈、憋氣、勉強下壓","建議次數組數":"5–8 次，量力而為","難度":"新手","器材":"椅子","示範影片":"media/office/o11.svg"},
  {"id":"o12","notionId":"407d474379d8818aa6d5d534bb0adaab","動作名稱":"頸部旋轉","訓練部位":["頸"],"主要肌群":"胸鎖乳突肌、頭夾肌","動作要點":"坐直收下巴，慢慢把頭轉向一側看向肩膀，到緊繃處停住，再慢慢轉回另一側","常見錯誤":"轉太快甩頭、頭前伸、身體跟著轉","建議次數組數":"每邊停 5 秒 × 5 次","難度":"新手","器材":"徒手","示範影片":"media/office/o12.svg"},
  {"id":"o13","notionId":"407d474379d8819396ccfccaefe23266","動作名稱":"背手擴胸","訓練部位":["胸","肩"],"主要肌群":"胸大肌、三角肌前束","動作要點":"雙手在背後十指交扣，手臂伸直往後下延伸，同時挺胸、肩胛骨夾緊，視柔軟度可再把手往上抬","常見錯誤":"駝背、聳肩、腰過度往前凹","建議次數組數":"20–30 秒 × 2 回","難度":"新手","器材":"徒手","示範影片":"media/office/o13.svg"},
  {"id":"o14","notionId":"407d474379d881ac8723c463d3f95d4c","動作名稱":"門框胸大肌伸展","訓練部位":["胸","肩"],"主要肌群":"胸大肌、胸小肌","動作要點":"前臂貼在門框或牆角，手肘約與肩同高，同側腳往前一步，身體慢慢往前帶，感覺胸前拉開","常見錯誤":"手肘高過肩造成肩膀卡、聳肩、腰往前凸","建議次數組數":"每邊 20–30 秒 × 2 回","難度":"新手","器材":"牆面/門框","示範影片":"media/office/o14.svg"},
  {"id":"o15","notionId":"407d474379d881ae9756ef6077186b20","動作名稱":"坐姿四字形伸展","訓練部位":["臀","下背"],"主要肌群":"梨狀肌、臀大肌","動作要點":"坐直，右腳踝放在左膝上呈「4」字，背打直從髖關節往前傾，感覺右臀深處拉開","常見錯誤":"彎腰駝背往前、用手大力壓膝蓋、臀部歪斜","建議次數組數":"每邊 20–30 秒 × 2 回","難度":"新手","器材":"椅子","示範影片":"media/office/o15.svg"},
  {"id":"o16","notionId":"407d474379d881b0a5bac8306a12d540","動作名稱":"肩膀繞環","訓練部位":["肩","上背"],"主要肌群":"上斜方肌、三角肌、菱形肌","動作要點":"手臂自然垂放，肩膀往上聳→往後夾→往下沉，畫大圓；先往後繞再往前繞","常見錯誤":"只聳肩沒往後繞、速度太快、頭跟著動","建議次數組數":"往後 10 圈 + 往前 10 圈","難度":"新手","器材":"徒手","示範影片":"media/office/o16.svg"},
  {"id":"o17","notionId":"407d474379d881b2a8bbc454c6d0bd65","動作名稱":"上斜方肌伸展","訓練部位":["頸","肩"],"主要肌群":"上斜方肌","動作要點":"右手抓住椅面固定肩膀，頭往左側傾（耳朵靠向肩膀），左手輕放頭側加一點重量，感覺右側頸肩拉開","常見錯誤":"被拉的那側聳肩、用手大力拉頭、身體跟著歪","建議次數組數":"每邊 20–30 秒 × 2–3 回","難度":"新手","器材":"椅子","示範影片":"media/office/o17.svg"},
  {"id":"o18","notionId":"407d474379d881cba957c4dfe3997b72","動作名稱":"毛巾肩胛下拉","訓練部位":["上背","肩"],"主要肌群":"下斜方肌、背闊肌","動作要點":"雙手拉緊毛巾兩端舉過頭，吐氣時手肘往下往後拉到毛巾在頭後方（約耳朵高度），肩胛下沉夾緊，再慢慢上推","常見錯誤":"頭往前伸、聳肩、腰往前凹","建議次數組數":"10–12 下 × 2 組","難度":"中階","器材":"毛巾","示範影片":"media/office/o18.svg"},
  {"id":"o19","notionId":"407d474379d881eb9c91ce45ba8a1900","動作名稱":"坐姿脊椎扭轉","訓練部位":["上背","下背","核心"],"主要肌群":"腹內外斜肌、豎脊肌","動作要點":"坐直雙腳踩地，左手放右膝外側、右手扶椅背，吐氣時從腰到胸慢慢往右轉，頭最後跟上","常見錯誤":"只轉頭、彎腰駝背、骨盆跟著轉","建議次數組數":"每邊 15–30 秒 × 2 回","難度":"新手","器材":"椅子","示範影片":"media/office/o19.svg"},
  {"id":"o20","notionId":"407d474379d881f0b544ee04898bae70","動作名稱":"頭頂三頭肌伸展","訓練部位":["手臂","肩"],"主要肌群":"肱三頭肌、背闊肌","動作要點":"右手舉高、手肘彎曲讓手掌落到背後，左手扶右手肘輕輕往後下壓","常見錯誤":"頭往前低、腰往前凸、用力壓肘","建議次數組數":"每邊 20 秒 × 2 回","難度":"新手","器材":"徒手","示範影片":"media/office/o20.svg"}
]
